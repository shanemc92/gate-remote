# Signs the session cookie carrying the CSRF token. The app refuses to start
# without it. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

GATE_WEBHOOK_URL=""
GATE_WEBHOOK_TAG=shinto_shrine

# Optional: pull a still image from an RTSP camera to show gate position.
# Leave blank to disable the camera panel entirely.
RTSP_URL=rtsp://username:password@192.168.1.50/stream
SNAPSHOT_INTERVAL=10
